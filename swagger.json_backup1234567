{
  "openapi": "3.0.1",
  "info": {
    "title": "Keycloak–Zoho Proxy API",
    "description": "Proxy between Keycloak authentication and Zoho ServiceDesk API.\n\nUse `/api/token` to obtain a Keycloak access token, then use that token with the `/api/v3/requests` endpoints.",
    "version": "1.0.1"
  },
  "servers": [
    {
      "url": "http://51.21.81.193:5555",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "KeycloakTokenRequest": {
        "type": "object",
        "properties": {
          "grant_type": { "type": "string", "example": "client_credentials" },
          "client_id": { "type": "string", "example": "test" },
          "client_secret": { "type": "string", "example": "VBVfm8H5WXdqKIgiiP3BdDuKqXgdJoWl" },
          "scope": { "type": "string", "example": "tickets.read_only tickets.write" }
        }
      },
      "CreateRequest": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "template": { "type": "object", "properties": { "id": { "type": "string" } } },
              "requester": { "type": "object", "properties": { "name": { "type": "string" } } },
              "site": { "type": "object", "properties": { "name": { "type": "string" } } },
              "request_type": { "type": "object", "properties": { "name": { "type": "string" } } },
              "priority": { "type": "object", "properties": { "name": { "type": "string" } } },
              "status": { "type": "object", "properties": { "name": { "type": "string" } } },
              "category": { "type": "object", "properties": { "name": { "type": "string" } } },
              "mode": { "type": "object", "properties": { "name": { "type": "string" } } },
              "subcategory": { "type": "object", "properties": { "name": { "type": "string" } } },
              "group": { "type": "object", "properties": { "name": { "type": "string" } } },
              "technician": { "type": "object", "properties": { "name": { "type": "string" } } },
              "subject": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["requester", "subject", "description"]
          }
        },
        "example": {
          "request": {
            "template": { "id": "228538000000542001" },
            "requester": { "name": "emillearns@gmail.com" },
            "site": { "name": "Base Site" },
            "request_type": { "name": "Incident" },
            "priority": { "name": "High" },
            "status": { "name": "Open" },
            "category": { "name": "Fiber" },
            "mode": { "name": "E-Mail" },
            "subcategory": { "name": "Outage" },
            "group": { "name": "App Development" },
            "technician": { "name": "emillearns@gmail.com" },
            "subject": "Test using Swagger",
            "description": "Test ticket"
          }
        }
      }
    }
  },
  "paths": {
    "/api/token": {
      "post": {
        "summary": "Get Access Token from Keycloak",
        "description": "Proxy request to Keycloak’s token endpoint. Use this to obtain a JWT token for other API calls.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/KeycloakTokenRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Token retrieved successfully" },
          "500": { "description": "Token error" }
        }
      }
    },
    "/api/v3/requests": {
      "get": {
        "summary": "List Zoho Requests",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of Zoho tickets" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a new Zoho Request",
        "description": "Creates a new ticket in Zoho ServiceDesk.\n\n💡 **Important:** Prefer `application/json`. If using `application/x-www-form-urlencoded`, send `input_data={...}` as plain JSON (not URL-encoded).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRequest" }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "input_data": { "$ref": "#/components/schemas/CreateRequest" }
                },
                "example": {
                  "input_data": {
                    "request": {
                      "template": { "id": "228538000000542001" },
                      "requester": { "name": "emillearns@gmail.com" },
                      "subject": "Form Example Ticket",
                      "description": "Form-based request"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Ticket created successfully" },
          "400": { "description": "Invalid request or JSON parse error" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v3/requests/{id}": {
      "get": {
        "summary": "Get Request by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Request details" },
          "404": { "description": "Request not found" }
        }
      },
      "put": {
        "summary": "Update Request by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Request updated successfully" },
          "400": { "description": "Invalid input" }
        }
      }
    },
    "/api/v3/requests/{id}/_uploads": {
      "post": {
        "summary": "Upload Attachment",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to upload"
                  },
                  "addtoattachment": {
                    "type": "string",
                    "example": "true"
                  }
                },
                "required": ["filename"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Attachment uploaded" },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Check if proxy service is up.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "example": { "status": "ok", "message": "Proxy service running" }
              }
            }
          }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
